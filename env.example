OPENAI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GITHUB_TOKEN=
GITHUB_REPO=dlatevilawson/talkforge
# Optional privileged key for admin migrations only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 (optional). Create a GA4 property → Measurement ID (G-…).
# Set in Vercel → Project → Settings → Environment Variables for Production.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Atlas runtime flags (ATLAS-D-FLAGS)
# TARGET defaults ON (active internal). Set off only for emergency rollback.
# FOUNDER_VISIBLE defaults OFF (observation window). Do not enable without Founder Decision.
# ATLAS_RUNTIME_TARGET=on
# ATLAS_RUNTIME_FOUNDER_VISIBLE=off

