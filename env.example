OPENAI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by newer Supabase docs (falls back to ANON_KEY in code)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GITHUB_TOKEN=
GITHUB_REPO=dlatevilawson/talkforge
# Optional privileged key for admin migrations / Founder bootstrap only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL for auth redirects (verification, password reset, OAuth)
# NEXT_PUBLIC_SITE_URL=https://talkforge.io

# Google Analytics 4. Defaults to TalkForge production ID G-6Y0CCE4X1Q in code.
# Override in Vercel if you need a different property:
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Founder / Admin roles (production) ---
# Assign via profiles.role in Supabase after the user signs up with the shared login.
# Do not use a separate Founder login. Optional allowlist helpers can still seed role:
# FOUNDER_USER_IDS=uuid-from-auth-users

# --- Development-only Founder bootstrap (NEVER enable in production) ---
# Requires ALL of:
#   NODE_ENV !== production
#   VERCEL_ENV !== production
#   FOUNDER_DEV_ENABLED=true
#   FOUNDER_DEV_PASSWORD set (do not commit the password)
# Email defaults to founder@talkforge.io. First login forces password change.
# FOUNDER_DEV_ENABLED=true
# FOUNDER_DEV_EMAIL=founder@talkforge.io
# FOUNDER_DEV_PASSWORD=

# Atlas runtime flags (ATLAS-D-FLAGS)
# TARGET defaults ON (active internal). Set off only for emergency rollback.
# FOUNDER_VISIBLE defaults OFF (observation window). Do not enable without Founder Decision.
# ATLAS_RUNTIME_TARGET=on
# ATLAS_RUNTIME_FOUNDER_VISIBLE=off
