OPENAI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GITHUB_TOKEN=
GITHUB_REPO=dlatevilawson/talkforge
# Optional privileged key for admin migrations only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4. Defaults to TalkForge production ID G-6Y0CCE4X1Q in code.
# Override in Vercel if you need a different property:
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Founder role (same login as members) ---
# Production: comma-separated profile IDs that receive Founder role after shared login.
# FOUNDER_USER_IDS=your-stable-user-id

# Temporary local/dev elevation ONLY (cannot enable on Vercel Production):
# Requires NODE_ENV!=production AND VERCEL_ENV!=production AND the flag below.
# Sign in with the display name FOUNDER_DEV_DISPLAY_NAME via /login (same form).
# FOUNDER_DEV_ENABLED=true
# FOUNDER_DEV_USER_ID=founder-dev
# FOUNDER_DEV_DISPLAY_NAME=Founder

# Atlas runtime flags (ATLAS-D-FLAGS)
# TARGET defaults ON (active internal). Set off only for emergency rollback.
# FOUNDER_VISIBLE defaults OFF (observation window). Do not enable without Founder Decision.
# ATLAS_RUNTIME_TARGET=on
# ATLAS_RUNTIME_FOUNDER_VISIBLE=off
