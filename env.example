OPENAI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by newer Supabase docs (falls back to ANON_KEY in code)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GITHUB_TOKEN=
GITHUB_REPO=dlatevilawson/talkforge
# Optional privileged key for admin / Founder bootstrap only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Assistant Coach anonymous session cookie signing (Phase 4B.3) — server only.
# Required for GET/POST /api/assistant-coach/session. Min 32 characters.
# Never prefix with NEXT_PUBLIC_. Rotate by minting a new secret (existing cookies re-mint).
# ASSISTANT_COACH_ANON_COOKIE_SECRET=

# Optional anon turn safety/economic cap (Phase 4B.5). Default 10. Not the conversion gate.
# ASSISTANT_COACH_ANON_TURN_CAP=10

# Canonical public site URL for auth redirects (verification, password reset, OAuth)
# Local: http://localhost:3000
# Preview + Production: https://talkforge.io
NEXT_PUBLIC_SITE_URL=https://talkforge.io

# Google Analytics 4. Defaults to TalkForge production ID G-6Y0CCE4X1Q in code.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Production authentication (AUTH-001) ---
# Single system: /signup /login /verify-email /forgot-password /reset-password
# Founder Portal is role-gated after the same login — not a separate auth product.
# FOUNDER_USER_IDS=uuid-from-auth-users

# --- Development-only Founder bootstrap (NEVER enable in production) ---
# Local testing aid only. Hard-blocked when NODE_ENV=production or VERCEL_ENV=production.
# FOUNDER_DEV_ENABLED=true
# FOUNDER_DEV_EMAIL=founder@talkforge.io
# FOUNDER_DEV_PASSWORD=

# Supabase Management API token (local ops only) — used by: npm run auth:configure
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=wudjmxqbsozreepgjvef

# Atlas runtime flags (ATLAS-D-FLAGS)
# ATLAS_RUNTIME_TARGET=on
# ATLAS_RUNTIME_FOUNDER_VISIBLE=off
